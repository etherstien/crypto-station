# ── Netlify environment variables (Site settings → Environment) ──
SUPABASE_URL=https://<PROJECT-REF>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service role key — Settings → API. NEVER expose to browser>
TV_WEBHOOK_SECRET=<any long random string; also goes in your TradingView alert URLs>

# ── Supabase Edge Function secrets (supabase secrets set KEY=value) ──
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are auto-injected by Supabase.
JOB_SECRET=<any long random string; must match cron.sql>
COINGECKO_API_KEY=<free Demo key from coingecko.com/api>
COINALYZE_API_KEY=<free key from coinalyze.net>
POLYMARKET_SLUGS=<optional: comma-separated market slugs to snapshot>
